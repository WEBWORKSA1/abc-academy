<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% if p.title and p.noindex != true %}<url><loc>{{ site.url }}{{ p.url | replace: 'index.html', '' }}</loc><lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod></url>
